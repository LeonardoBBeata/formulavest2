NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Nunca habilite em produção. Com true, os códigos de cadastro/login aparecem na interface para testes.
EXPOSE_TEST_CODES=true

# Em docker-compose.prod.yml, use "postgres" como host em vez de "localhost".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/formulavest
DATABASE_SSL=false
# Para o docker-compose.prod.yml, configure também POSTGRES_DB, POSTGRES_USER e POSTGRES_PASSWORD.
POSTGRES_DB=formulavest
POSTGRES_USER=formulavest
POSTGRES_PASSWORD=troque_por_uma_senha_forte
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# Executa os testes de integração com PostgreSQL (o CI já ativa esta opção).
RUN_DB_TESTS=false

JWT_SECRET=troque_por_uma_chave_grande_e_secreta
MASTER_PASSWORD=troque_por_uma_senha_forte

# Em desenvolvimento, use EMAIL_PROVIDER=console para registrar os códigos apenas no terminal.
# Em produção, use Outlook somente com SMTP AUTH habilitado para a caixa.
EMAIL_PROVIDER=outlook-smtp
OUTLOOK_EMAIL=
OUTLOOK_APP_PASSWORD=

OPENROUTER_API_KEY=
# Este modelo requer créditos no OpenRouter. Troque por outro modelo disponível,
# se preferir.
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
