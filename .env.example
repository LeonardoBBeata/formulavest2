NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Nunca habilite em produção. Com true, os códigos de cadastro/login aparecem na interface para testes.
EXPOSE_TEST_CODES=true

# Em docker-compose.prod.yml, use "postgres" como host em vez de "localhost".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/formulavest
DATABASE_SSL=false
# Para o docker-compose.prod.yml, configure também POSTGRES_DB, POSTGRES_USER e POSTGRES_PASSWORD.
POSTGRES_DB=formulavest
POSTGRES_USER=formulavest
POSTGRES_PASSWORD=troque_por_uma_senha_forte
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# Executa os testes de integração com PostgreSQL (o CI já ativa esta opção).
RUN_DB_TESTS=false

JWT_SECRET=troque_por_uma_chave_grande_e_secreta
MASTER_PASSWORD=troque_por_uma_senha_forte
# Optional locally; the seed defaults to 12345678 outside production.
PROFESSOR_PASSWORD=

# Modo temporário local: exibe os códigos na interface e não envia emails.
# TEMPORARY_OTP_DISPLAY é a exceção explícita para um teste controlado em produção.
EMAIL_PROVIDER=console
# Só habilite em produção durante um teste controlado sem email; isso remove o segundo fator.
TEMPORARY_OTP_DISPLAY=false
# Para voltar ao Resend depois de verificar o remetente, use EMAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=FormulaVest

OPENROUTER_API_KEY=
# Modelo gratuito por padrão para evitar falhas por falta de créditos.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
